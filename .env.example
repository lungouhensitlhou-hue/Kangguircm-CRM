# ---- Database (Postgres 14+) ------------------------------------------------------------------
DATABASE_URL=postgres://rcm:rcm@localhost:5432/rcm

# ---- Web app ------------------------------------------------------------------------------------
# Public URL of the web app. Used to build unsubscribe links in emails: must be reachable by recipients.
APP_BASE_URL=http://localhost:3000
# Single-operator login. REQUIRED in production (the app refuses to log anyone in without them).
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=use-a-long-random-passphrase
# 32+ random chars, e.g. `openssl rand -base64 32`
SESSION_SECRET=
# Set to 1 only if you run production behind plain HTTP (not recommended).
# INSECURE_COOKIES=1

# ---- AI agents (worker) ----------------------------------------------------------------------------
# Set ONE provider key and it is auto-detected (precedence: Anthropic > Gemini > custom base URL > the OpenAI-format list).
# Or force a provider with LLM_PROVIDER=anthropic|gemini|openai|groq|together|mistral|deepseek|xai|openrouter|
#   perplexity|fireworks|cerebras|ollama|lmstudio|custom
# No key at all is fine: the agents fall back to rule-based research, template drafts and command-style chat.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
# Any OpenAI-compatible server (self-hosted vLLM, Azure gateway, LiteLLM...): LLM_PROVIDER=custom + these three
# LLM_BASE_URL=https://your-host/v1
# LLM_API_KEY=
# Local models via Ollama need no key:  LLM_PROVIDER=ollama  AGENT_MODEL=llama3.1
# Model to use. Defaults: Anthropic claude-opus-5-5, others have a starting default that may be out of date, so set it.
AGENT_MODEL=
# Optional cost tracking for non-Claude models (USD per million tokens)
# LLM_PRICE_IN=
# LLM_PRICE_OUT=
WORKER_CONCURRENCY=3

# ---- Research ----------------------------------------------------------------------------------------
# Finds a practice's website when the registry lacks one. Any ONE of these (auto-detected), or SEARCH_PROVIDER=brave|tavily|serper|serpapi|off
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=

# ---- Email ----------------------------------------------------------------------------------------------
# Any ONE of these (auto-detected), or EMAIL_PROVIDER=resend|sendgrid|postmark|mailgun|smtp. None = dry-run (nothing is delivered).
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=
# POSTMARK_MESSAGE_STREAM=outbound
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# MAILGUN_REGION=eu
# e.g. smtps://user:pass@smtp.yourprovider.com:465  (Google Workspace, Microsoft 365, SES SMTP, ...)
SMTP_URL=
# Shared secret for POST /api/inbound (reply webhook). Send it in the x-webhook-secret header.
INBOUND_WEBHOOK_SECRET=
