# ---- Database (Postgres 14+) ------------------------------------------------------------------
DATABASE_URL=postgres://rcm:rcm@localhost:5432/rcm

# ---- Web app ------------------------------------------------------------------------------------
# Public URL of the web app. Used to build unsubscribe links in emails: must be reachable by recipients.
APP_BASE_URL=http://localhost:3000
# Single-operator login. REQUIRED in production (the app refuses to log anyone in without them).
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=use-a-long-random-passphrase
# 32+ random chars, e.g. `openssl rand -base64 32`
SESSION_SECRET=
# Set to 1 only if you run production behind plain HTTP (not recommended).
# INSECURE_COOKIES=1

# ---- AI agents (worker) ----------------------------------------------------------------------------
# Without a key the agents still run using rule-based fallbacks (heuristic research, template drafts, command chat).
ANTHROPIC_API_KEY=
# Default: claude-opus-5-5. Cheaper option for high volume: claude-sonnet-5-5
AGENT_MODEL=claude-opus-5-5
WORKER_CONCURRENCY=3

# ---- Research ----------------------------------------------------------------------------------------
# Brave Search API key: lets the researcher find a practice's website when the registry doesn't list one.
BRAVE_API_KEY=

# ---- Email ----------------------------------------------------------------------------------------------
# e.g. smtps://user:pass@smtp.yourprovider.com:465  (Google Workspace, Microsoft 365, Postmark, SES, ...)
# Unset = dry-run: approved emails are recorded as sent but NOT delivered.
SMTP_URL=
# Shared secret for POST /api/inbound (reply webhook). Send it in the x-webhook-secret header.
INBOUND_WEBHOOK_SECRET=
